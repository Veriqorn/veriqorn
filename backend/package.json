{
  "name": "veriqorn-backend",
  "version": "0.2.39",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "reset-local-admin": "bun scripts/reset-local-admin.ts",
    "build": "bun build src/index.ts --target bun --outdir dist --packages external",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src test",
    "check": "bun run lint && bun run typecheck && bun run test:run && bun run build",
    "test": "bun test",
    "test:run": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@veriqorn/contracts": "workspace:*",
    "@veriqorn/extension-sdk": "workspace:*",
    "adm-zip": "0.6.1",
    "bcrypt": "6.0.0",
    "cookie": "2.0.2",
    "dotenv": "18.0.9",
    "elysia": "1.4.31",
    "jose": "6.2.15",
    "minio": "8.0.7",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/node": "26.6.6",
    "bun-types": "1.4.4",
    "oxlint": "1.92.0",
    "typescript": "7.0.2"
  }
}
