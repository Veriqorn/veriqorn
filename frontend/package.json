{
  "name": "veriqorn-frontend",
  "version": "0.2.39",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:3000": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "bun server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test vite.config.ts vitest.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "bun run lint && bun run typecheck && bun run test:run && bun run build",
    "check:strict": "bun run check",
    "docker:build": "docker build -t veriqorn-frontend ."
  },
  "dependencies": {
    "@veriqorn/extension-sdk": "workspace:*",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@veriqorn/contracts": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "oxlint": "1.92.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  }
}
