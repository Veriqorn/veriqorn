{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "node": true
  },
  "plugins": [
    "typescript",
    "react"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react/set-state-in-effect": "warn",
    "react/immutability": "warn"
  },
  "ignorePatterns": [
    "dist",
    "coverage",
    "node_modules"
  ]
}
